    "test.jaffle_shop.assert_frontier_events_resolve": {
      "resource_type": "test",
      "unique_id": "test.jaffle_shop.assert_frontier_events_resolve",
      "name": "assert_frontier_events_resolve",
      "database": "DATA_AGENT_DEV",
      "schema": "DBT_DEV_dbt_test__audit",
      "alias": "assert_frontier_events_resolve",
      "package_name": "jaffle_shop",
      "depends_on": {
        "nodes": [
          "seed.jaffle_shop.change_events",
          "model.jaffle_shop.stg_customers",
          "model.jaffle_shop.stg_orders"
        ],
        "macros": []
      },
      "original_file_path": "tests/assert_frontier_events_resolve.sql",
      "path": "assert_frontier_events_resolve.sql",
      "fqn": [
        "jaffle_shop",
        "assert_frontier_events_resolve"
      ],
      "tags": [
        "frontier_demo"
      ],
      "compiled_code": "-- Every change event must resolve to a current or before-image customer.\n\n\nwith resolved_events as (\n\n    select distinct ce.event_id\n    from DATA_AGENT_DEV.DBT_DEV_raw.change_events ce\n    inner join DATA_AGENT_DEV.DBT_DEV.stg_customers c\n        on ce.source_model = 'stg_customers'\n       and ce.entity_key = 'customer_id'\n       and c.customer_id = ce.entity_value::number\n\n    union\n\n    select distinct ce.event_id\n    from DATA_AGENT_DEV.DBT_DEV_raw.change_events ce\n    inner join DATA_AGENT_DEV.DBT_DEV.stg_orders o\n        on ce.source_model = 'stg_orders'\n       and ce.entity_key = 'order_id'\n       and o.order_id = ce.entity_value::number\n\n    union\n\n    select distinct event_id\n    from DATA_AGENT_DEV.DBT_DEV_raw.change_events\n    where prior_customer_id is not null\n\n)\n\nselect ce.*\nfrom DATA_AGENT_DEV.DBT_DEV_raw.change_events ce\nleft join resolved_events re using (event_id)\nwhere re.event_id is null",
      "raw_code": "-- Every change event must resolve to a current or before-image customer.\n{{ config(tags=['frontier_demo']) }}\n\nwith resolved_events as (\n\n    select distinct ce.event_id\n    from {{ ref('change_events') }} ce\n    inner join {{ ref('stg_customers') }} c\n        on ce.source_model = 'stg_customers'\n       and ce.entity_key = 'customer_id'\n       and c.customer_id = ce.entity_value::number\n\n    union\n\n    select distinct ce.event_id\n    from {{ ref('change_events') }} ce\n    inner join {{ ref('stg_orders') }} o\n        on ce.source_model = 'stg_orders'\n       and ce.entity_key = 'order_id'\n       and o.order_id = ce.entity_value::number\n\n    union\n\n    select distinct event_id\n    from {{ ref('change_events') }}\n    where prior_customer_id is not null\n\n)\n\nselect ce.*\nfrom {{ ref('change_events') }} ce\nleft join resolved_events re using (event_id)\nwhere re.event_id is null",
      "columns": {}
    },
    "test.jaffle_shop.assert_frontier_matches_full_mart": {
      "resource_type": "test",
      "unique_id": "test.jaffle_shop.assert_frontier_matches_full_mart",
      "name": "assert_frontier_matches_full_mart",
      "database": "DATA_AGENT_DEV",
      "schema": "DBT_DEV_dbt_test__audit",
      "alias": "assert_frontier_matches_full_mart",
      "package_name": "jaffle_shop",
      "depends_on": {
        "nodes": [
          "model.jaffle_shop.customer_summary",
          "model.jaffle_shop.frontier_affected_customers",
          "model.jaffle_shop.frontier_customer_summary_target"
        ],
        "macros": []
      },
      "original_file_path": "tests/assert_frontier_matches_full_mart.sql",
      "path": "assert_frontier_matches_full_mart.sql",
      "fqn": [
        "jaffle_shop",
        "assert_frontier_matches_full_mart"
      ],
      "tags": [
        "frontier_demo"
      ],
      "compiled_code": "-- The targeted recomputation must equal the corresponding rows in the full\n-- customer mart. Any returned row fails this dbt singular test.\n\n\nwith expected as (\n\n    select cs.*\n    from DATA_AGENT_DEV.DBT_DEV.customer_summary cs\n    inner join DATA_AGENT_DEV.DBT_DEV.frontier_affected_customers f\n        on cs.customer_id = f.customer_id\n\n),\n\nactual as (\n\n    select *\n    from DATA_AGENT_DEV.DBT_DEV.frontier_customer_summary_target\n\n),\n\nmissing_or_changed as (\n\n    select * from expected\n    except\n    select * from actual\n\n),\n\nunexpected_or_changed as (\n\n    select * from actual\n    except\n    select * from expected\n\n)\n\nselect 'missing_or_changed' as difference_type, * from missing_or_changed\nunion all\nselect 'unexpected_or_changed' as difference_type, * from unexpected_or_changed",
      "raw_code": "-- The targeted recomputation must equal the corresponding rows in the full\n-- customer mart. Any returned row fails this dbt singular test.\n{{ config(tags=['frontier_demo']) }}\n\nwith expected as (\n\n    select cs.*\n    from {{ ref('customer_summary') }} cs\n    inner join {{ ref('frontier_affected_customers') }} f\n        on cs.customer_id = f.customer_id\n\n),\n\nactual as (\n\n    select *\n    from {{ ref('frontier_customer_summary_target') }}\n\n),\n\nmissing_or_changed as (\n\n    select * from expected\n    except\n    select * from actual\n\n),\n\nunexpected_or_changed as (\n\n    select * from actual\n    except\n    select * from expected\n\n)\n\nselect 'missing_or_changed' as difference_type, * from missing_or_changed\nunion all\nselect 'unexpected_or_changed' as difference_type, * from unexpected_or_changed",
      "columns": {}
    },
